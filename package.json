{
  "name": "chirp",
  "version": "1.0.0",
  "private": true,
  "description": "Chirp \u2014 a realistic Twitter/X clone teaching sample (Next.js 14 App Router + SQLite)",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --require ./scripts/test-aliases.cjs --test '.cache/chirp-test/tests/**/*.test.js'",
    "check": "pnpm typecheck && pnpm build",
    "test:seed": "node scripts/check-seed.mjs",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write app components lib scripts tests docs README.md AGENTS.md",
    "format:check": "prettier --check app components lib scripts tests docs README.md AGENTS.md"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "prettier": "3.5.3",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=24"
  }
}
